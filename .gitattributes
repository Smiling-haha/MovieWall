# 统一换行：仓库内用 LF，检出时按平台转换
* text=auto eol=crlf

# 源码与文档固定 LF
*.cs      text eol=lf
*.xaml    text eol=lf
*.csproj  text eol=lf
*.sln     text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.py      text eol=lf

# 二进制：不做换行转换、不做 diff
*.exe     binary
*.dll     binary
*.pdb     binary
*.png     binary
*.jpg     binary
*.ico     binary
*.7z      binary
