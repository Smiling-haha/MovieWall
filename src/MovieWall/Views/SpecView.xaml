<UserControl x:Class="MovieWall.Views.SpecView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:MovieWall.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1440" d:DesignHeight="900"
             Background="#060607"
             FontFamily="{StaticResource F_UI}">

    <UserControl.Resources>

        <!-- 规格行：左标签右值 -->
        <DataTemplate x:Key="SpecRowTemplate">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource T_Field}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource T_Value}"
                           TextWrapping="Wrap" TextTrimming="None" TextAlignment="Right" />
            </Grid>
        </DataTemplate>

        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource B_Text3}" />
        </Style>

        <Style x:Key="ColumnHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource B_Text2}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部栏 ============ -->
        <Grid Grid.Row="0" Margin="40,58,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource Btn_Ghost}"
                    Padding="16,8" Click="OnBackClick" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✕" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="返回片库" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Margin="24,2,24,0" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="▤" FontSize="10" Foreground="{StaticResource B_Text4}"
                               Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentMovie.FilePath}"
                               FontSize="11" Foreground="{StaticResource B_Text3}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button x:Name="RevealLink" Margin="10,0,0,0" Click="OnRevealClick"
                            Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="在文件夹中显示 →" FontSize="11"
                                   Foreground="{StaticResource B_Text2}" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="⛨" FontSize="9" Foreground="{StaticResource B_Text4}"
                               Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="仅在本地读取与播放 · 不上传视频文件"
                               FontSize="10.5" Foreground="{StaticResource B_Text4}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Btn_Circle}" Click="OnReproceClick" ToolTip="重新分析媒体参数" Margin="0,0,10,0">
                    <TextBlock Text="↻" FontSize="14" />
                </Button>
                <Button Style="{StaticResource Btn_Circle}" Click="OnCloseClick" ToolTip="关闭">
                    <TextBlock Text="✕" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ 内容 ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="0,22,0,0"
                      controls:SmoothScroll.IsEnabled="True"
                      controls:SmoothScroll.Step="120">

            <StackPanel Margin="104,10,104,64" MaxWidth="1180" HorizontalAlignment="Center">

                <!-- TECHNICAL SPECIFICATIONS -->
                <Grid>
                    <TextBlock Text="—   T E C H N I C A L   S P E C I F I C A T I O N S"
                               Style="{StaticResource SectionHead}" />
                    <TextBlock Text="L O C A L   M E D I A   A N A L Y S I S"
                               Style="{StaticResource SectionHead}" HorizontalAlignment="Right" />
                </Grid>

                <!-- 三栏 -->
                <Grid Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 视频 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="◧  视频" Style="{StaticResource ColumnHead}" />
                        <ItemsControl ItemsSource="{Binding CurrentMovie.VideoRows}"
                                      ItemTemplate="{StaticResource SpecRowTemplate}"
                                      Focusable="False" />
                    </StackPanel>

                    <!-- 文件 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="◫  文件" Style="{StaticResource ColumnHead}" />
                        <ItemsControl ItemsSource="{Binding CurrentMovie.FileRows}"
                                      ItemTemplate="{StaticResource SpecRowTemplate}"
                                      Focusable="False" />
                    </StackPanel>

                    <!-- 音频 + 字幕 -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="♪  音频" Style="{StaticResource ColumnHead}" />

                        <ItemsControl ItemsSource="{Binding CurrentMovie.AudioTracks}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                   Foreground="{StaticResource B_Text1}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding ShortLabel}"
                                                   FontSize="11.5" Foreground="{StaticResource B_Text3}"
                                                   Margin="10,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="无音轨信息" FontSize="11.5" Foreground="{StaticResource B_Text4}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentMovie.HasAudioTracks}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- 字幕 -->
                        <TextBlock Text="▭  字幕" Style="{StaticResource ColumnHead}" Margin="0,22,0,14" />

                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="内封字幕" FontSize="11.5"
                                       Foreground="{StaticResource B_Text3}" />
                            <TextBlock Text="{Binding CurrentMovie.Detail.TextCount}"
                                       FontSize="11.5" Foreground="{StaticResource B_Text1}"
                                       HorizontalAlignment="Right" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding CurrentMovie.TextTracks}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#0FFFFFFF" CornerRadius="3" Padding="5,2"
                                                VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Badge}" FontSize="9"
                                                       Foreground="{StaticResource B_Text2}" />
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                                       Foreground="{StaticResource B_Text1}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SubLine}" FontSize="10"
                                                       Foreground="{StaticResource B_Text4}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- ============ FULL MEDIA PARAMETERS ============ -->
                <Grid Margin="0,52,0,0">
                    <TextBlock Text="—   F U L L   M E D I A   P A R A M E T E R S"
                               Style="{StaticResource SectionHead}" />
                    <TextBlock Text="{Binding DataContext.MediaInfoLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Style="{StaticResource SectionHead}" HorizontalAlignment="Right" />
                </Grid>

                <Border Height="1" Background="#141416" Margin="0,12,0,20" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl Grid.Column="0" ItemsSource="{Binding CurrentMovie.FullRowsLeft}"
                                  ItemTemplate="{StaticResource SpecRowTemplate}" Focusable="False" />

                    <ItemsControl Grid.Column="2" ItemsSource="{Binding CurrentMovie.FullRowsRight}"
                                  ItemTemplate="{StaticResource SpecRowTemplate}" Focusable="False" />
                </Grid>

                <!-- MediaInfo 缺失提示 -->
                <Border Background="#0DFFFFFF" CornerRadius="6" Padding="16,12" Margin="0,26,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.MediaProbeAvailable, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="没有找到 MediaInfo，当前显示的是 Windows 系统属性能读到的有限信息。把 MediaInfo.exe 放到程序目录的 tools\ 文件夹下即可获得完整的容器、编码、色彩与 HDR 参数。"
                               TextWrapping="Wrap" FontSize="11.5" LineHeight="20"
                               Foreground="{StaticResource B_Text3}" />
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
