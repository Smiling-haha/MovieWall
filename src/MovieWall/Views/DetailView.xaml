<UserControl x:Class="MovieWall.Views.DetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:MovieWall.Controls"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             mc:Ignorable="d"
             d:DesignWidth="1440" d:DesignHeight="900"
             Background="#060607"
             FontFamily="{StaticResource F_UI}">

    <UserControl.Resources>
        <!-- 键值对：左标签右值 -->
        <Style x:Key="KV_Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource B_Text4}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <Style x:Key="KV_Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource B_Text2}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 四个数据块 -->
        <Style x:Key="Stat_Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource B_Text4}" />
        </Style>

        <Style x:Key="Stat_Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>

        <!-- ============ 背景：海报放大模糊，只留一点色温 ============ -->
        <Rectangle Fill="{Binding CurrentMovie.PlaceholderBrush}" />
        <Rectangle Opacity="0.42">
            <Rectangle.Fill>
                <ImageBrush ImageSource="{Binding CurrentMovie.PosterImage}" Stretch="UniformToFill" />
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="110" KernelType="Gaussian" />
            </Rectangle.Effect>
        </Rectangle>

        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush GradientOrigin="0.32,0.32" Center="0.32,0.32"
                                     RadiusX="0.95" RadiusY="0.95">
                    <GradientStop Color="#B3060607" Offset="0" />
                    <GradientStop Color="#FA060607" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============ 内容 ============ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      controls:SmoothScroll.IsEnabled="True"
                      controls:SmoothScroll.Step="120">
            <Grid Margin="80,96,80,56" MaxWidth="1140" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== 左：大海报 ===== -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <Border x:Name="PosterHost" Width="208" Height="312"
                            CornerRadius="4"
                            Background="{Binding CurrentMovie.PlaceholderBrush}">
                        <Grid>
                            <Image x:Name="BigPoster"
                                   Source="{Binding CurrentMovie.PosterImage}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding CurrentMovie.Initials}"
                                       FontSize="56" FontWeight="Light" Foreground="#28FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Margin="1,10,1,0">
                        <TextBlock Text="IMDb" FontSize="10" Foreground="{StaticResource B_Text4}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding CurrentMovie.PosterSourceLabel}"
                                   FontSize="10" Foreground="{StaticResource B_Text4}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- ===== 右：信息 ===== -->
                <StackPanel Grid.Column="1" Margin="52,0,0,0">

                    <!-- 眉标 -->
                    <TextBlock Text="{Binding CurrentMovie.EyebrowLine}"
                               Style="{StaticResource T_Eyebrow}" />

                    <!-- 片名 -->
                    <TextBlock Text="{Binding CurrentMovie.DisplayTitle}"
                               FontSize="40" FontWeight="Light"
                               Foreground="{StaticResource B_Text1}"
                               TextWrapping="Wrap"
                               Margin="0,14,0,0" />

                    <TextBlock Text="{Binding CurrentMovie.OriginalTitle}"
                               FontSize="14"
                               Foreground="{StaticResource B_Text3}"
                               Margin="0,8,0,0"
                               Visibility="{Binding CurrentMovie.HasOriginalTitle, Converter={StaticResource BoolToVis}}" />

                    <!-- 评分行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0"
                                Visibility="{Binding CurrentMovie.HasRating, Converter={StaticResource BoolToVis}}">
                        <Border Background="#14FFFFFF" CornerRadius="4" Padding="9,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="豆瓣" FontSize="10.5"
                                           Foreground="{StaticResource B_Text3}"
                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding CurrentMovie.RatingText}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource B_Text1}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="/10" FontSize="10"
                                           Foreground="{StaticResource B_Text4}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding CurrentMovie.ScoreLine}"
                                   FontSize="11" Foreground="{StaticResource B_Text3}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>

                    <!-- 主创信息（两列） -->
                    <Grid Margin="0,26,0,0" MaxWidth="620" HorizontalAlignment="Left"
                          Visibility="{Binding CurrentMovie.HasCredits, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,24,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="导演" Style="{StaticResource KV_Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentMovie.Director}"
                                       Style="{StaticResource KV_Value}" />
                        </Grid>

                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="主演" Style="{StaticResource KV_Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentMovie.Actors}"
                                       Style="{StaticResource KV_Value}" />
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,24,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="类型" Style="{StaticResource KV_Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentMovie.GenreText}"
                                       Style="{StaticResource KV_Value}" />
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="制片国家" Style="{StaticResource KV_Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentMovie.Countries}"
                                       Style="{StaticResource KV_Value}" />
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="上映" Style="{StaticResource KV_Label}" />
                            <TextBlock Grid.Column="1" Text="{Binding CurrentMovie.ReleaseDate}"
                                       Style="{StaticResource KV_Value}" />
                        </Grid>
                    </Grid>

                    <!-- 四个数据块 -->
                    <Grid Margin="0,30,0,0" MaxWidth="620" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,30,0">
                            <TextBlock Text="时长" Style="{StaticResource Stat_Label}" />
                            <TextBlock Text="{Binding CurrentMovie.DurationText}" Style="{StaticResource Stat_Value}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,30,0">
                            <TextBlock Text="分辨率" Style="{StaticResource Stat_Label}" />
                            <TextBlock Text="{Binding CurrentMovie.ResolutionLabel}" Style="{StaticResource Stat_Value}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,30,0">
                            <TextBlock Text="视频码率" Style="{StaticResource Stat_Label}" />
                            <TextBlock Text="{Binding CurrentMovie.BitrateText}" Style="{StaticResource Stat_Value}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="文件大小" Style="{StaticResource Stat_Label}" />
                            <TextBlock Text="{Binding CurrentMovie.SizeText}" Style="{StaticResource Stat_Value}" />
                        </StackPanel>
                    </Grid>

                    <!-- 规格 chips -->
                    <ItemsControl ItemsSource="{Binding CurrentMovie.Chips}" Margin="0,24,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Chip_Spec}">
                                    <TextBlock Text="{Binding}" FontSize="10"
                                               Foreground="{StaticResource B_Text2}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 操作区 -->
                    <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                        <Button Style="{StaticResource Btn_Primary}" Click="OnPlayClick">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M0,0 L10,6 L0,12 Z" Fill="#0A0A0B" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DataContext.PlayerName, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='用 {0} 播放'}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Btn_Circle}" Margin="12,0,0,0"
                                Click="OnFavoriteClick"
                                ToolTip="收藏 / 取消收藏">
                            <TextBlock Text="{Binding CurrentMovie.FavoriteGlyph}" FontSize="15" />
                        </Button>

                        <Button Style="{StaticResource Btn_Circle}" Margin="10,0,0,0"
                                Click="OnSpecClick"
                                ToolTip="完整技术参数">
                            <TextBlock Text="⌗" FontSize="15" />
                        </Button>

                        <TextBlock Text="拖拽给本机播放器打开" FontSize="11"
                                   Foreground="{StaticResource B_Text4}"
                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>

                    <!-- 故事简介 -->
                    <Grid Margin="0,42,0,0" MaxWidth="720" HorizontalAlignment="Left"
                          Visibility="{Binding CurrentMovie.HasOverview, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="故事简介" FontSize="11.5"
                                   Foreground="{StaticResource B_Text3}"
                                   HorizontalAlignment="Left" />
                        <TextBlock Text="来源 · 豆瓣" FontSize="10"
                                   Foreground="{StaticResource B_Text4}"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <Border Height="1" Background="#141416" Margin="0,10,0,14"
                            MaxWidth="720" HorizontalAlignment="Left"
                            Visibility="{Binding CurrentMovie.HasOverview, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding CurrentMovie.Overview}"
                               TextWrapping="Wrap"
                               FontSize="12.5"
                               LineHeight="24"
                               Foreground="{StaticResource B_Text2}"
                               MaxWidth="720"
                               HorizontalAlignment="Left"
                               Visibility="{Binding CurrentMovie.HasOverview, Converter={StaticResource BoolToVis}}" />

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ============================================================
             顶部操作条：必须放在 ScrollViewer 之后（Z 序更高），
             且 y 必须大于窗口标题栏高度 46，否则点击会被 WindowChrome
             当成「拖拽窗口」吞掉——这就是之前返回和刷新按不动的原因。
             ============================================================ -->
        <Button Style="{StaticResource Btn_Ghost}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="40,58,0,0"
                Padding="16,8"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Click="OnBackClick">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✕" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="返回片库" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- 右上角两个圆形操作 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,58,40,0">
            <Button Style="{StaticResource Btn_Circle}" Click="OnRescrapeClick" ToolTip="重新获取信息"
                    Margin="0,0,10,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="↻" FontSize="14" />
            </Button>
            <Button Style="{StaticResource Btn_Circle}" Click="OnRevealClick" ToolTip="在文件夹中显示"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="▤" FontSize="13" />
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
