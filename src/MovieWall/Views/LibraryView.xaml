<UserControl x:Class="MovieWall.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:MovieWall.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1440" d:DesignHeight="900"
             Background="Transparent"
             FontFamily="{StaticResource F_UI}">

    <UserControl.Resources>

        <!-- 磁盘 chip：小圆角方块，比按钮更紧凑 -->
        <Style x:Key="Chip_Disk" TargetType="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource B_Text2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource B_StrokeSoft}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource B_Surface}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource B_Stroke}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource B_SurfaceHi}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#4DFFFFFF" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部筛选 tab -->
        <Style x:Key="Tab_Text" TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource B_Text3}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,0,0,10" />
            <Setter Property="Margin" Value="0,0,26,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource B_Text2}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 排序文字 -->
        <Style x:Key="Text_Sort" TargetType="Button">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource B_Text3}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="6,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             页头
             ============================================================ -->
        <StackPanel Grid.Row="0" Margin="40,56,40,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="—   Y O U R   P R I V A T E   C O L L E C T I O N"
                               Style="{StaticResource T_Eyebrow}" />

                    <TextBlock Text="我的电影." Style="{StaticResource T_Display}" Margin="0,8,0,0" />

                    <TextBlock Text="{Binding HeaderSummary}"
                               Style="{StaticResource T_Caption}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="⟳" FontSize="10" Foreground="{StaticResource B_Text4}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding StatusLine}" FontSize="11"
                                   Foreground="{StaticResource B_Text3}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Style="{StaticResource Btn_Ghost}"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"
                            Padding="18,9"
                            Click="OnRescanClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⟳" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ScanButtonText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 磁盘 chips -->
            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Chip_Disk}" Click="OnAllDiskClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="10" Margin="0,0,6,0"
                                       Foreground="{StaticResource B_Text3}" VerticalAlignment="Center" />
                            <TextBlock Text="全部" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AllCountText}" Margin="8,0,0,0"
                                       Foreground="{StaticResource B_Text3}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ItemsControl ItemsSource="{Binding Disks}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Chip_Disk}" Tag="{Binding Root}"
                                        Click="OnDiskChipClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse Stroke="#7A7A84" StrokeThickness="0.9" />
                                            <Ellipse Width="2" Height="2" Fill="#7A7A84"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Detail}" Margin="8,0,0,0"
                                                   Foreground="{StaticResource B_Text4}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 筛选 + 搜索 / 排序 -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">

                    <StackPanel>
                        <Button Click="OnAllFilterClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Tab_Text}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllFilter}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="全部" />
                                <TextBlock Text="{Binding AllCountText}" Margin="6,0,0,0"
                                           Foreground="{StaticResource B_Text4}" />
                            </StackPanel>
                        </Button>
                        <Border Height="1" Background="{StaticResource B_White}"
                                Visibility="{Binding IsAllFilter, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel>
                        <Button Click="OnLocalFilterClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Tab_Text}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocalFilter}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="本机" />
                                <TextBlock Text="{Binding LocalCountText}" Margin="6,0,0,0"
                                           Foreground="{StaticResource B_Text4}" />
                            </StackPanel>
                        </Button>
                        <Border Height="1" Background="{StaticResource B_White}"
                                Visibility="{Binding IsLocalFilter, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel>
                        <Button Click="OnExternalFilterClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Tab_Text}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExternalFilter}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="外挂" />
                                <TextBlock Text="{Binding ExternalCountText}" Margin="6,0,0,0"
                                           Foreground="{StaticResource B_Text4}" />
                            </StackPanel>
                        </Button>
                        <Border Height="1" Background="{StaticResource B_White}"
                                Visibility="{Binding IsExternalFilter, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <StackPanel>
                        <Button Click="OnFavoriteFilterClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Tab_Text}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavoriteFilter}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="收藏" />
                                <TextBlock Text="{Binding FavoriteCountText}" Margin="6,0,0,0"
                                           Foreground="{StaticResource B_Text4}" />
                            </StackPanel>
                        </Button>
                        <Border Height="1" Background="{StaticResource B_White}"
                                Visibility="{Binding IsFavoriteFilter, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="188">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource Input_Search}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="搜索影片"
                                   IsHitTestVisible="False"
                                   Margin="30,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{StaticResource B_Text4}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="⌕" IsHitTestVisible="False"
                                   Margin="11,0,0,0" VerticalAlignment="Center"
                                   FontSize="13" Foreground="{StaticResource B_Text4}" />
                    </Grid>

                    <Button Style="{StaticResource Text_Sort}" Click="OnSortClick" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="排序" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SortLabel}" Foreground="{StaticResource B_Text2}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="#141416" Margin="0,14,0,0" />
        </StackPanel>

        <!-- ============================================================
             海报墙
             ============================================================ -->
        <ScrollViewer Grid.Row="1"
                      x:Name="WallScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False"
                      Margin="0,4,0,0"
                      controls:SmoothScroll.IsEnabled="True"
                      controls:SmoothScroll.Step="200">

            <ItemsControl ItemsSource="{Binding VisibleMovies}" Focusable="False"
                          HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:VirtualizingWrapPanel ItemWidth="210"
                                                        ItemHeight="366"
                                                        Spacing="18"
                                                        HorizontalPadding="40"
                                                        VerticalPadding="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:PosterCard CardClicked="OnCardClicked" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 空状态 -->
        <Grid Grid.Row="1" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock Text="还没有影片" Style="{StaticResource T_PageTitle}" HorizontalAlignment="Center" />
                <TextBlock Text="扫描硬盘和 U 盘，把散落各处的片子收成一面海报墙。整个过程只读取文件名，不上传任何路径。"
                           Style="{StaticResource T_Body}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />
                <Button Content="立即扫描"
                        Style="{StaticResource Btn_Primary}"
                        HorizontalAlignment="Center"
                        Margin="0,26,0,0"
                        Click="OnRescanClick" />
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
