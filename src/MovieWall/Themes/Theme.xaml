<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MovieWall.Converters">

    <conv:LetterSpaceConverter x:Key="LetterSpace" />
    <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
    <conv:NotEmptyToCollapsedConverter x:Key="NotEmptyToCollapsed" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ============================================================
         设计令牌
         纯黑打底、白灰做层次，全部颜色只在明度上做区分，
         不引入任何彩色——让海报本身成为画面里唯一的颜色来源。
         ============================================================ -->

    <Color x:Key="C_Bg">#060607</Color>
    <Color x:Key="C_BgRaised">#0B0B0D</Color>
    <Color x:Key="C_Surface">#111113</Color>
    <Color x:Key="C_SurfaceHi">#191920</Color>
    <Color x:Key="C_Stroke">#242428</Color>
    <Color x:Key="C_StrokeSoft">#1A1A1D</Color>
    <Color x:Key="C_Text1">#F3F3F4</Color>
    <Color x:Key="C_Text2">#8D8D95</Color>
    <Color x:Key="C_Text3">#5B5B63</Color>
    <Color x:Key="C_Text4">#3E3E45</Color>
    <Color x:Key="C_White">#FFFFFF</Color>

    <SolidColorBrush x:Key="B_Bg" Color="{StaticResource C_Bg}" />
    <SolidColorBrush x:Key="B_BgRaised" Color="{StaticResource C_BgRaised}" />
    <SolidColorBrush x:Key="B_Surface" Color="{StaticResource C_Surface}" />
    <SolidColorBrush x:Key="B_SurfaceHi" Color="{StaticResource C_SurfaceHi}" />
    <SolidColorBrush x:Key="B_Stroke" Color="{StaticResource C_Stroke}" />
    <SolidColorBrush x:Key="B_StrokeSoft" Color="{StaticResource C_StrokeSoft}" />
    <SolidColorBrush x:Key="B_Text1" Color="{StaticResource C_Text1}" />
    <SolidColorBrush x:Key="B_Text2" Color="{StaticResource C_Text2}" />
    <SolidColorBrush x:Key="B_Text3" Color="{StaticResource C_Text3}" />
    <SolidColorBrush x:Key="B_Text4" Color="{StaticResource C_Text4}" />
    <SolidColorBrush x:Key="B_White" Color="{StaticResource C_White}" />

    <FontFamily x:Key="F_UI">Segoe UI, Microsoft YaHei UI, PingFang SC, sans-serif</FontFamily>
    <FontFamily x:Key="F_Narrow">Segoe UI Semibold, Microsoft YaHei UI</FontFamily>

    <!-- ============================================================
         文字
         ============================================================ -->

    <!-- 「我的电影.」那种大标题：大字号 + 细字重，是整套设计的性格所在 -->
    <Style x:Key="T_Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="T_PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- 「— YOUR PRIVATE COLLECTION」那种小标签 -->
    <Style x:Key="T_Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource B_Text3}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="T_Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
    </Style>

    <Style x:Key="T_Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource B_Text2}" />
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <Style x:Key="T_Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource B_Text3}" />
    </Style>

    <!-- 规格表里左侧的字段名 -->
    <Style x:Key="T_Field" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B_Text3}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 规格表里右侧的值 -->
    <Style x:Key="T_Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ============================================================
         滚动条：6px，无箭头
         ============================================================ -->

    <Style x:Key="SB_Thumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="3" Background="#26FFFFFF" Margin="1,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#4DFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#80FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SB_NoButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="7" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SB_NoButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SB_Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SB_NoButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         按钮
         ============================================================ -->

    <!-- 主按钮：白底黑字胶囊 -->
    <Style x:Key="Btn_Primary" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{StaticResource B_White}" />
        <Setter Property="Foreground" Value="#0A0A0B" />
        <Setter Property="Padding" Value="26,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="24"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 描边胶囊 -->
    <Style x:Key="Btn_Ghost" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="20,11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="22"
                            BorderBrush="{StaticResource B_Stroke}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource B_Surface}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#3A3A42" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource B_SurfaceHi}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 圆形图标按钮 -->
    <Style x:Key="Btn_Circle" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Foreground" Value="{StaticResource B_Text2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="21"
                            BorderBrush="{StaticResource B_Stroke}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource B_Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 顶栏无边框图标按钮 -->
    <Style x:Key="Btn_Icon" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B_Text2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource B_Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         搜索框
         ============================================================ -->

    <Style x:Key="Input_Search" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
        <Setter Property="CaretBrush" Value="{StaticResource B_White}" />
        <Setter Property="SelectionBrush" Value="#4DFFFFFF" />
        <Setter Property="Background" Value="{StaticResource B_Surface}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource B_StrokeSoft}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#4DFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         表单控件（深色）
         —— 系统默认的 TextBox / ComboBox / CheckBox / ListBox 都是浅色的，
            深色界面下会直接变成「白块 + 白字」，字全看不见。
            这里每个控件都给完整模板，颜色一律走设计令牌。
         ============================================================ -->

    <Style x:Key="Input_Dark" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
        <Setter Property="CaretBrush" Value="{StaticResource B_White}" />
        <Setter Property="SelectionBrush" Value="#66FFFFFF" />
        <Setter Property="Background" Value="{StaticResource B_Surface}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource B_StrokeSoft}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9" SnapsToDevicePixels="True">
                        <!-- 上下留 0：文字靠 VerticalUnit 居中，不会被 Padding 挤没 -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B_Stroke}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#59FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource B_Text4}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboItem_Dark" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B_Text2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="11,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="4,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E1E26" />
                            <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource B_White}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Combo_Dark" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
        <Setter Property="Background" Value="{StaticResource B_Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource B_StrokeSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem_Dark}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="Sel" Grid.Column="0" Margin="12,0,6,0"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}" />

                                <Path Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"
                                      Data="M0,0 L3.6,3.6 L7.2,0"
                                      Stroke="{StaticResource B_Text2}" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Border>

                        <!-- 整个控件都能点开，而不是只有那个小箭头 -->
                        <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                                      Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                               Placement="Bottom" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource B_SurfaceHi}"
                                    BorderBrush="{StaticResource B_Stroke}" BorderThickness="1"
                                    CornerRadius="8" Margin="0,4,0,0" Padding="0,4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B_Stroke}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#59FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Check_Dark" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource B_Text2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="14" Height="14" CornerRadius="3.5"
                                Background="{StaticResource B_Surface}"
                                BorderBrush="{StaticResource B_Text4}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M2.4,6.6 L5.4,9.6 L11,3.4"
                                  Stroke="#060607" StrokeThickness="1.6" Visibility="Collapsed"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource B_White}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B_White}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource B_Text3}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListItem_Dark" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B_Text2}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2,1"
                            Padding="8,6">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#17171C" />
                            <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#22222A" />
                            <Setter Property="Foreground" Value="{StaticResource B_White}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="List_Dark" TargetType="ListBox">
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="Background" Value="{StaticResource B_Surface}" />
        <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
        <Setter Property="BorderBrush" Value="{StaticResource B_StrokeSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListItem_Dark}" />
    </Style>

    <!-- 规格 chip：详情页那排 4K UHD / HDR10 / HEVC · 10BIT -->
    <Style x:Key="Chip_Spec" TargetType="Border">
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="BorderBrush" Value="#14FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Margin" Value="0,0,7,0" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource B_SurfaceHi}" />
        <Setter Property="Foreground" Value="{StaticResource B_Text1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource B_Stroke}" />
        <Setter Property="FontFamily" Value="{StaticResource F_UI}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
