<Window x:Class="MovieWall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:MovieWall.Views"
        Title="LUMEN · 私人影院"
        Icon="Assets/app.ico"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#060607"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Btn_Win" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A1A1D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Btn_WinClose" TargetType="Button" BasedOn="{StaticResource Btn_Win}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource B_Text3}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="SetSection" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource B_Text4}" />
            <Setter Property="Margin" Value="0,26,0,14" />
        </Style>
    </Window.Resources>

    <Grid Background="#060607">

        <!-- ============ 页面 ============ -->
        <Grid x:Name="PageHost">
            <views:LibraryView x:Name="PageLibrary"
                               Visibility="{Binding IsLibraryPage, Converter={StaticResource BoolToVis}}" />
            <views:DetailView x:Name="PageDetail"
                              Visibility="{Binding IsDetailPage, Converter={StaticResource BoolToVis}}" />
            <views:SpecView x:Name="PageSpec"
                            Visibility="{Binding IsSpecPage, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- ============ 顶栏 ============ -->
        <Grid VerticalAlignment="Top" Height="46" Background="#060607">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- LUMEN -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="20,0,0,0">
                <Grid Width="17" Height="17" ClipToBounds="True">
                    <Ellipse Width="15" Height="15" Fill="#F2F2F3" HorizontalAlignment="Left" />
                    <Ellipse Width="15" Height="15" Fill="#060607" HorizontalAlignment="Left" Margin="7,0,0,0" />
                </Grid>

                <TextBlock Text="LUMEN" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource B_Text1}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />

                <TextBlock Text="P R I V A T E   C I N E M A" FontSize="7.5"
                           Foreground="{StaticResource B_Text4}" Margin="12,1,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- 状态 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="4" Height="4" Fill="{StaticResource B_Text3}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding TopStatus}" FontSize="10.5"
                           Foreground="{StaticResource B_Text3}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 右侧 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                <Button Style="{StaticResource Btn_Icon}" Click="OnOpenSettingsClick" ToolTip="设置"
                        VerticalAlignment="Center" Margin="0,0,4,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="⚙" FontSize="13" />
                </Button>

                <Button x:Name="BtnMin" Style="{StaticResource Btn_Win}" Click="OnMinimizeClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M0,0 L10,0" Stroke="#8A8A92" StrokeThickness="1" />
                </Button>

                <Button x:Name="BtnMax" Style="{StaticResource Btn_Win}" Click="OnMaximizeClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path x:Name="MaxIcon" Data="M0,0 L9,0 L9,9 L0,9 Z"
                          Stroke="#8A8A92" StrokeThickness="1" />
                </Button>

                <Button x:Name="BtnClose" Style="{StaticResource Btn_WinClose}" Click="OnCloseClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#8A8A92" StrokeThickness="1" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ 设置 ============ -->
        <Grid x:Name="SettingsOverlay" Background="#B3060607" Visibility="Collapsed" Opacity="0">
            <Border Width="680" MaxHeight="720"
                    Background="#0B0B0D"
                    BorderBrush="{StaticResource B_Stroke}" BorderThickness="1"
                    CornerRadius="10"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="30,24,22,0">
                        <TextBlock Text="设置" FontSize="17" FontWeight="Light"
                                   Foreground="{StaticResource B_Text1}" />
                        <Button Style="{StaticResource Btn_Icon}" HorizontalAlignment="Right"
                                Click="OnCancelSettingsClick">
                            <TextBlock Text="✕" FontSize="12" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0"
                                  Padding="30,0,22,10">
                        <StackPanel>

                            <TextBlock Text="—   元数据与海报" Style="{StaticResource SetSection}" Margin="0,4,0,12" />

                            <TextBlock Text="TMDB API Key（留空自动使用免 Key 的豆瓣）" Style="{StaticResource SetLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtTmdbKey" Style="{StaticResource Input_Dark}" />
                                <Button Grid.Column="1" Content="测试" Style="{StaticResource Btn_Ghost}"
                                        Margin="8,0,0,0" Padding="16,7" Click="OnTestSourceClick" />
                            </Grid>

                            <TextBlock x:Name="TxtSourceStatus" FontSize="10.5"
                                       Foreground="{StaticResource B_Text3}"
                                       Margin="1,8,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="代理（TMDB 用，例 http://127.0.0.1:7890；留空跟随系统）"
                                       Style="{StaticResource SetLabel}" Margin="0,14,0,0" />
                            <TextBox x:Name="TxtProxy" Style="{StaticResource Input_Dark}" />

                            <CheckBox x:Name="ChkDoubanOnly" Content="只用豆瓣（不走 TMDB）"
                                      Style="{StaticResource Check_Dark}" Margin="0,16,0,0" />

                            <!-- 播放 -->
                            <TextBlock Text="—   播放" Style="{StaticResource SetSection}" />

                            <TextBlock Text="播放器（留空 = 系统默认关联程序）" Style="{StaticResource SetLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbPlayer" Style="{StaticResource Combo_Dark}" />
                                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource Btn_Ghost}"
                                        Margin="8,0,0,0" Padding="14,7" Click="OnBrowsePlayerClick" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="按钮名称" Style="{StaticResource SetLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" x:Name="TxtPlayerName" Style="{StaticResource Input_Dark}" MinHeight="32" />
                            </Grid>

                            <!-- 扫描 -->
                            <TextBlock Text="—   扫描范围" Style="{StaticResource SetSection}" />

                            <ListBox x:Name="LstRoots" Style="{StaticResource List_Dark}" Height="96" />
                            <TextBlock Text="留空 = 自动扫描所有固定磁盘；U 盘插入时按上面的规则自动纳入。"
                                       FontSize="10.5" Foreground="{StaticResource B_Text3}"
                                       Margin="1,7,0,0" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button Content="添加目录" Style="{StaticResource Btn_Ghost}"
                                        Padding="14,7" Click="OnAddRootClick" />
                                <Button Content="移除选中" Style="{StaticResource Btn_Ghost}"
                                        Padding="14,7" Margin="8,0,0,0" Click="OnRemoveRootClick" />
                            </StackPanel>

                            <CheckBox x:Name="ChkAutoScan" Content="启动时自动增量扫描"
                                      Style="{StaticResource Check_Dark}" Margin="0,18,0,0" />

                            <CheckBox x:Name="ChkWatchDrives" Content="监听 U 盘 / 移动硬盘插拔"
                                      Style="{StaticResource Check_Dark}" Margin="0,12,0,0" />

                            <CheckBox x:Name="ChkMoviesOnly" Content="只显示影片（隐藏宣传片、录像、分集切片）"
                                      Style="{StaticResource Check_Dark}" Margin="0,12,0,0" />
                            <TextBlock Text="关掉后所有视频文件都会上墙，包括手机录像和展陈循环素材。"
                                       FontSize="10.5" Foreground="{StaticResource B_Text3}"
                                       Margin="22,6,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="最小计入体积（MB）" Style="{StaticResource SetLabel}" Margin="0,20,0,7" />
                            <TextBox x:Name="TxtMinSize" Style="{StaticResource Input_Dark}"
                                     MinHeight="32" Width="120" HorizontalAlignment="Left" />

                            <TextBlock Text="—   本地缓存" Style="{StaticResource SetSection}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtCacheSize" FontSize="11.5"
                                           Foreground="{StaticResource B_Text2}" VerticalAlignment="Center" />
                                <Button Content="清空海报缓存" Style="{StaticResource Btn_Ghost}"
                                        Padding="14,7" Margin="14,0,0,0" Click="OnClearCacheClick" />
                            </StackPanel>

                            <TextBlock Margin="0,24,0,4" FontSize="10.5"
                                       Foreground="{StaticResource B_Text4}" TextWrapping="Wrap"
                                       Text="隐私：扫描只读取文件名、体积和修改时间；刮削时仅把「片名 + 年份」发给元数据服务。完整路径、盘符和观看记录都只留在这台电脑上。" />

                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="#17171A" BorderThickness="0,1,0,0" Padding="30,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Style="{StaticResource Btn_Ghost}" Padding="20,8"
                                    Click="OnCancelSettingsClick" />
                            <Button Content="保存" Style="{StaticResource Btn_Primary}" Margin="10,0,0,0"
                                    Padding="24,9" Click="OnSaveSettingsClick" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Toast ============ -->
        <Border x:Name="ToastHost"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,36"
                Padding="18,10"
                CornerRadius="8"
                Background="#F016161A"
                BorderBrush="#2A2A30" BorderThickness="1"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock Text="{Binding ToastText}" FontSize="11.5"
                       Foreground="{StaticResource B_Text1}" />
        </Border>

    </Grid>
</Window>
